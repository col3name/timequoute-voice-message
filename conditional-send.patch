+        void update() {
+            int threshold = ConditionalSend.thresholdMb();
+            int index = 0;
+            for (int i = 0; i < values.length; i++) {
+                if (values[i] == threshold) {
+                    index = i;
+                    break;
+                }
+            }
+            titleView.setText(LocaleController.getString(R.string.ConditionalSendSettingsThreshold));
+            seekBarView.setProgress(index / (float) (values.length - 1));
+            updateValue(index);
+        }
+
+        private void updateValue(int index) {
