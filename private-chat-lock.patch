+        ListAdapter(Context context) { this.context = context; }
+        @Override public boolean isEnabled(RecyclerView.ViewHolder holder) { return true; }
+        @Override public int getItemCount() { return lockedIds.size(); }
+        @Override public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+            DialogCell cell = new DialogCell(null, context, false, false, currentAccount, null);
+            cell.setLayoutParams(new RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(56)));
+            return new RecyclerListView.Holder(cell);
+        }
+        @Override public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+            DialogCell cell = (DialogCell) holder.itemView;
+            TLRPC.Dialog dialog = MessagesController.getInstance(currentAccount).dialogs_dict.get(lockedIds.get(position));
+            if (dialog != null) {
+                cell.setDialog(dialog, DialogsActivity.DIALOGS_TYPE_DEFAULT, 0);
+            }
+        }
+    }
+
+    public static class PrivateChatLockSettingsActivity extends BaseFragment {
+        private TextCheckCell hideCell;
+        private SettingsAdapter settingsAdapter;
+
+        @Override
+        public View createView(Context context) {
+            actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+            actionBar.setAllowOverlayTitle(true);
+            actionBar.setTitle("Chat lock settings");
+            actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+                @Override
+                public void onItemClick(int id) { if (id == -1) finishFragment(); }
+            });
+            FrameLayout frame = new FrameLayout(context);
+            frame.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+            RecyclerListView listView = new RecyclerListView(context);
+            actionBar.setAdaptiveBackground(listView);
+            listView.setClipToPadding(false);
+            listView.setPadding(dp(16), dp(12), dp(16), 0);
+            listView.setLayoutManager(new LinearLayoutManager(context));
+            settingsAdapter = new SettingsAdapter(context);
+            listView.setAdapter(settingsAdapter);
+            frame.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+            listView.setOnItemClickListener((view, position) -> {
+                if (position == 0) {
+                    boolean hide = !PrivateChatLock.isHideLocked(currentAccount);
+                    if (hide) {
+                        showDialog(new AlertDialog.Builder(getParentActivity())
+                                .setTitle("Hide secret chats")
+                                .setMessage("Hide your chats with a secret code for more privacy. Find locked chats by entering your code in the search bar on the Chats tab. Your chats will appear after you enter the code.")
+                                .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                                .setPositiveButton("Hide chats", (dialog, which) -> {
+                                    PrivateChatLock.setHideLocked(currentAccount, true);
+                                    hideCell.setChecked(true);
+                                    settingsAdapter.notifyDataSetChanged();
+                                }).create());
+                    } else {
+                        PrivateChatLock.setHideLocked(currentAccount, false);
+                        hideCell.setChecked(false);
+                        settingsAdapter.notifyDataSetChanged();
+                    }
+                } else if (!PrivateChatLock.isHideLocked(currentAccount) && position == 1) {
+                    presentFragment(new PrivateChatLockActivity());
+                } else if (position == (PrivateChatLock.isHideLocked(currentAccount) ? 1 : 2)) {
+                    requestCurrentSecretCode();
+                }
+            });
+            fragmentView = frame;
+            return fragmentView;
+        }
+
+        @Override
+        public void onResume() {
+            super.onResume();
+            if (settingsAdapter != null) {
+                settingsAdapter.notifyDataSetChanged();
+            }
+        }
+
+        private void requestCurrentSecretCode() {
+            if (!PrivateChatLock.hasCode(currentAccount)) {
+                presentFragment(new ActionIntroActivity(ActionIntroActivity.ACTION_TYPE_SET_PRIVATE_CODE));
+                return;
+            }
+            presentFragment(new PasscodeActivity(PasscodeActivity.TYPE_ENTER_PRIVATE_CODE));
+        }
+
+        private class SettingsAdapter extends RecyclerListView.SelectionAdapter {
+            private final Context context;
+            SettingsAdapter(Context context) { this.context = context; }
+            @Override public boolean isEnabled(RecyclerView.ViewHolder holder) { return true; }
+            @Override public int getItemCount() { return PrivateChatLock.isHideLocked(currentAccount) ? 4 : 5; }
+            @Override public int getItemViewType(int position) {
+                if (position == 0) return 0;
+                int secretCodePosition = PrivateChatLock.isHideLocked(currentAccount) ? 1 : 2;
+                return position == 1 && !PrivateChatLock.isHideLocked(currentAccount) || position == secretCodePosition ? 1 : position == secretCodePosition + 1 ? 2 : 3;
+            }
+            @Override public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int type) {
+                View view;
+                if (type == 0) view = hideCell = new TextCheckCell(context);
+                else if (type == 1) view = new TextCell(context);
+                else if (type == 2) view = new HeaderCell(context);
+                else view = new TextInfoPrivacyCell(context);
+                return new RecyclerListView.Holder(view);
+            }
+            private void styleCell(View view, int position) {
+                int privacyPosition = PrivateChatLock.isHideLocked(currentAccount) ? 2 : 3;
+                if (position > privacyPosition - 1) {
+                    view.setBackgroundColor(Color.TRANSPARENT);
+                    return;
+                }
+                float radius = dp(16);
+                int lastCardPosition = PrivateChatLock.isHideLocked(currentAccount) ? 1 : 2;
+                float[] radii = position == 0 ? new float[] {radius, radius, radius, radius, 0, 0, 0, 0} :
+                        position == lastCardPosition ? new float[] {0, 0, 0, 0, radius, radius, radius, radius} :
+                        new float[] {0, 0, 0, 0, 0, 0, 0, 0};
+                GradientDrawable background = new GradientDrawable();
+                background.setColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+                background.setCornerRadii(radii);
+                view.setBackground(background);
+            }
+            @Override public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+                styleCell(holder.itemView, position);
+                if (position == 0) {
+                    hideCell.setTextAndCheck("Hide secret chats", PrivateChatLock.isHideLocked(currentAccount), false);
+                } else if (!PrivateChatLock.isHideLocked(currentAccount) && position == 1) {
+                    ((TextCell) holder.itemView).setTextAndIcon("Locked chats", R.drawable.outline_header_lock_24, true);
+                } else if (position == (PrivateChatLock.isHideLocked(currentAccount) ? 1 : 2)) {
+                    ((TextCell) holder.itemView).setTextAndIcon(PrivateChatLock.hasCode(currentAccount) ? "Change secret code" : "Set secret code", R.drawable.outline_header_lock_24, true);
+                } else if (position == (PrivateChatLock.isHideLocked(currentAccount) ? 2 : 3)) {
+                    ((HeaderCell) holder.itemView).setText("Privacy");
+                } else {
+                    ((TextInfoPrivacyCell) holder.itemView).setText("Locked chats require your secret code to open. When Hide secret chats is off, they remain in the list with a lock icon.");
+                }
+            }
+        }
+    }
