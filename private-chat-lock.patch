+package org.telegram.messenger;
+
+import android.content.SharedPreferences;
+import android.util.Base64;
+
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.util.HashSet;
+import java.util.Set;
+
+import javax.crypto.SecretKeyFactory;
+import javax.crypto.spec.PBEKeySpec;
+
+/** Local, per-account UI state for hidden chats. This does not encrypt Telegram data. */
+public final class PrivateChatLock {
+    private static final SecureRandom RANDOM = new SecureRandom();
+    private static final long MAX_RETRY_DELAY_MS = 30_000L;
+
+    private PrivateChatLock() { }
+
+    private static SharedPreferences preferences(int account) {
+        return ApplicationLoader.applicationContext.getSharedPreferences("private_chats_" + account, 0);
+    }
+
+    public static boolean hasCode(int account) {
+        return preferences(account).contains("code_hash");
+    }
+
+    public static boolean checkCode(int account, String code) {
+        SharedPreferences prefs = preferences(account);
+        String saved = prefs.getString("code_hash", null);
+        String salt = prefs.getString("code_salt", null);
+        if (saved == null || salt == null || code == null) {
+            return false;
+        }
+        try {
+            byte[] expected = Base64.decode(saved, Base64.NO_WRAP);
+            byte[] actual = derive(code, Base64.decode(salt, Base64.NO_WRAP));
+            return MessageDigest.isEqual(expected, actual);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    public static long getUnlockRetryDelay(int account) {
+        long until = preferences(account).getLong("unlock_retry_until", 0L);
+        return Math.max(0L, until - System.currentTimeMillis());
+    }
+
+    public static void registerUnlockFailure(int account) {
+        SharedPreferences prefs = preferences(account);
+        int failures = prefs.getInt("unlock_failures", 0) + 1;
+        long delay = Math.min(MAX_RETRY_DELAY_MS, 1000L << Math.min(5, failures - 1));
+        prefs.edit().putInt("unlock_failures", failures)
+                .putLong("unlock_retry_until", System.currentTimeMillis() + delay).apply();
+    }
+
+    public static void resetUnlockFailures(int account) {
+        preferences(account).edit().remove("unlock_failures").remove("unlock_retry_until").apply();
+    }
+
+    public static boolean setCode(int account, String code) {
+        if (code == null || code.length() < 4) {
+            return false;
+        }
+        try {
+            byte[] salt = new byte[16];
+            RANDOM.nextBytes(salt);
+            preferences(account).edit()
+                    .putString("code_salt", Base64.encodeToString(salt, Base64.NO_WRAP))
+                    .putString("code_hash", Base64.encodeToString(derive(code, salt), Base64.NO_WRAP))
+                    .apply();
+            return true;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private static byte[] derive(String code, byte[] salt) throws Exception {
+        PBEKeySpec spec = new PBEKeySpec(code.toCharArray(), salt, 210000, 256);
+        try {
+            return SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).getEncoded();
+        } finally {
+            spec.clearPassword();
+        }
+    }
+
+    public static boolean isLocked(int account, long dialogId) {
+        return preferences(account).getStringSet("dialog_ids", java.util.Collections.emptySet()).contains(Long.toString(dialogId));
+    }
+
+    public static void setLocked(int account, long dialogId, boolean locked) {
+        SharedPreferences prefs = preferences(account);
+        Set<String> ids = new HashSet<>(prefs.getStringSet("dialog_ids", java.util.Collections.emptySet()));
+        if (locked) {
+            ids.add(Long.toString(dialogId));
+        } else {
+            ids.remove(Long.toString(dialogId));
+        }
+        prefs.edit().putStringSet("dialog_ids", ids).apply();
+    }
+
+    public static Set<Long> getLockedIds(int account) {
+        Set<Long> result = new HashSet<>();
+        for (String id : preferences(account).getStringSet("dialog_ids", java.util.Collections.emptySet())) {
+            try {
+                result.add(Long.parseLong(id));
+            } catch (NumberFormatException ignored) { }
+        }
+        return result;
+    }
+
+    public static boolean isHideLocked(int account) {
+        return preferences(account).getBoolean("hide_locked", true);
+    }
+
+    public static void setHideLocked(int account, boolean hide) {
+        preferences(account).edit().putBoolean("hide_locked", hide).apply();
+    }
+}
