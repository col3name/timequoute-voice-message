+
+public class PrivateChatLockActivity extends BaseFragment {
+    private final ArrayList<Long> lockedIds = new ArrayList<>();
+    private RecyclerListView listView;
+    private ListAdapter listAdapter;
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setTitle("Locked chats");
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) finishFragment();
+                else if (id == 1) presentFragment(new PrivateChatLockSettingsActivity());
+            }
+        });
+        ActionBarMenu menu = actionBar.createMenu();
+        ActionBarMenuItem settingsItem = menu.addItem(1, R.drawable.msg_settings);
+        settingsItem.setContentDescription("Settings");
+        lockedIds.clear();
+        lockedIds.addAll(PrivateChatLock.getLockedIds(currentAccount));
+        FrameLayout frame = new FrameLayout(context);
+        frame.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        EmptyTextProgressView emptyView = new EmptyTextProgressView(context);
+        emptyView.setTopImage(R.drawable.outline_header_lock_24);
+        emptyView.setText("No locked chats yet\n\nOpen a chat and choose Lock chat from its menu to add it here.");
+        emptyView.showTextView();
+        frame.addView(emptyView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        listView = new RecyclerListView(context);
+        actionBar.setAdaptiveBackground(listView);
+        listView.setLayoutManager(new LinearLayoutManager(context));
+        listView.setEmptyView(emptyView);
+        listView.setAdapter(listAdapter = new ListAdapter(context));
+        frame.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+        listView.setOnItemClickListener((view, position) -> {
+            if (position < 0 || position >= lockedIds.size()) return;
+            authenticateAndOpen(lockedIds.get(position));
+        });
+        fragmentView = frame;
+        return fragmentView;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        lockedIds.clear();
+        lockedIds.addAll(PrivateChatLock.getLockedIds(currentAccount));
+        if (listAdapter != null) {
+            listAdapter.notifyDataSetChanged();
+        }
+    }
+
+    private void authenticateAndOpen(long dialogId) {
+        if (getParentActivity() == null || LaunchActivity.instance == null ||
+                BiometricManager.from(getParentActivity()).canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_STRONG) != BiometricManager.BIOMETRIC_SUCCESS) {
+            showSecretCodeDialog(dialogId);
+            return;
+        }
+        Executor executor = ContextCompat.getMainExecutor(getParentActivity());
+        BiometricPrompt prompt = new BiometricPrompt(LaunchActivity.instance, executor, new BiometricPrompt.AuthenticationCallback() {
+            @Override
+            public void onAuthenticationSucceeded(@NonNull BiometricPrompt.AuthenticationResult result) {
+                openChat(dialogId);
+            }
+
+            @Override
+            public void onAuthenticationError(int errorCode, @NonNull CharSequence errString) {
+                showSecretCodeDialog(dialogId);
+            }
+        });
+        BiometricPrompt.PromptInfo promptInfo = new BiometricPrompt.PromptInfo.Builder()
+                .setTitle("Unlock chat")
+                .setSubtitle("Verify your identity to open this locked chat")
+                .setNegativeButtonText("Use secret code")
+                .setAllowedAuthenticators(BiometricManager.Authenticators.BIOMETRIC_STRONG)
+                .build();
+        prompt.authenticate(promptInfo);
+    }
+
+    private void showSecretCodeDialog(long dialogId) {
+        presentFragment(new PasscodeActivity(PasscodeActivity.TYPE_ENTER_PRIVATE_CODE_TO_CHAT, dialogId));
+    }
+
+    private void openChat(long dialogId) {
