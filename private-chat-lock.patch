+public class PrivateChatLockCodeActivity extends BaseFragment {
+    private final ArrayList<Long> dialogIds;
+    private EditTextSettingsCell codeField;
+    private EditTextSettingsCell confirmationField;
+
+    public PrivateChatLockCodeActivity(ArrayList<Long> dialogIds) {
+        this.dialogIds = dialogIds;
+    }
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setTitle(dialogIds == null ? "Change secret code" : "Set secret code");
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                } else if (id == 1) {
+                    saveCode();
+                }
+            }
+        });
+        ActionBarMenu menu = actionBar.createMenu();
+        ActionBarMenuItem done = menu.addItemWithWidth(1, R.drawable.ic_ab_done, dp(56));
+        done.setContentDescription(LocaleController.getString(R.string.Done));
+
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        HeaderCell header = new HeaderCell(context);
+        header.setText("Secret code");
+        layout.addView(header, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        codeField = createCodeField(context, "Secret code");
+        layout.addView(codeField, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        confirmationField = createCodeField(context, "Confirm secret code");
+        confirmationField.getTextView().setImeOptions(EditorInfo.IME_ACTION_DONE);
+        confirmationField.getTextView().setOnEditorActionListener((v, actionId, event) -> {
+            if (actionId == EditorInfo.IME_ACTION_DONE) {
+                saveCode();
+                return true;
+            }
+            return false;
+        });
+        layout.addView(confirmationField, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        layout.addView(createInfo(context), LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        fragmentView = layout;
+        return fragmentView;
+    }
+
+    private TextInfoPrivacyCell createInfo(Context context) {
+        TextInfoPrivacyCell info = new TextInfoPrivacyCell(context);
+        info.setText(dialogIds == null
+                ? "Choose a new code to protect your locked chats."
+                : "Create a secret code to hide the selected chats from the chat list.");
+        return info;
+    }
+
+    private EditTextSettingsCell createCodeField(Context context, String hint) {
+        EditTextSettingsCell field = new EditTextSettingsCell(context);
+        field.setTextAndHint("", hint, true);
+        field.getTextView().setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        field.getTextView().setImeOptions(EditorInfo.IME_ACTION_NEXT);
+        return field;
+    }
+
+    private void saveCode() {
+        String code = codeField == null ? "" : codeField.getText();
+        String confirmation = confirmationField == null ? "" : confirmationField.getText();
+        if (code.length() < 4) {
+            Toast.makeText(getParentActivity(), "Use at least 4 digits", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (!code.equals(confirmation)) {
+            confirmationField.getTextView().setError("Codes do not match");
+            confirmationField.getTextView().requestFocus();
+            return;
+        }
+        if (!PrivateChatLock.setCode(currentAccount, code)) {
+            Toast.makeText(getParentActivity(), "Couldn't save secret code", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        if (dialogIds != null) {
+            for (Long dialogId : dialogIds) {
+                PrivateChatLock.setLocked(currentAccount, dialogId, true);
+            }
+        }
+        AndroidUtilities.hideKeyboard(codeField.getTextView());
+        finishFragment();
+    }
+}
