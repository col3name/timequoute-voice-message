+			if (allowRollback && rollbackDate > getConnectionsManager().getCurrentTime()) {
+				createRescheduledCall(call, title, rollbackDate, 0, false);
+				return;
+			}
+			removeUpcomingCall(call.chat.id);
+			if (error != null) BulletinFactory.of(this).showForError(error);
+			loadUpcomingCalls(false);
+		}));
+	}
+
+	@Nullable
+	private TLRPC.InputGroupCall findScheduledCallInput(TLRPC.Updates updates) {
+		TLRPC.InputGroupCall call = findScheduledCallInput(updates.updates);
+		if (call != null) {
+			return call;
+		}
+		return updates.update != null ? findScheduledCallInput(updates.update) : null;
+	}
+
+	@Nullable
+	private TLRPC.InputGroupCall findScheduledCallInput(ArrayList<TLRPC.Update> updates) {
+		for (TLRPC.Update update : updates) {
+			TLRPC.InputGroupCall call = findScheduledCallInput(update);
+			if (call != null) {
+				return call;
+			}
+		}
+		return null;
+	}
+
+	@Nullable
+	private TLRPC.InputGroupCall findScheduledCallInput(TLRPC.Update update) {
+		if (update instanceof TL_update.TL_updateGroupCall) {
+			TLRPC.GroupCall groupCall = ((TL_update.TL_updateGroupCall) update).call;
+			if (groupCall != null && groupCall.id != 0 && groupCall.access_hash != 0) {
+				TLRPC.TL_inputGroupCall input = new TLRPC.TL_inputGroupCall();
+				input.id = groupCall.id;
+				input.access_hash = groupCall.access_hash;
+				return input;
+			}
+		}
+		return null;
+	}
+
+	private void updateUpcomingCallAfterReschedule(UpcomingCall oldCall, int date, TLRPC.Updates updates) {
+		TLRPC.InputGroupCall newCall = findScheduledCallInput(updates);
+		if (newCall == null) {
+			return;
+		}
+		UpcomingCall updated = new UpcomingCall(currentAccount, oldCall.chat, date, oldCall.video, oldCall.messageId, newCall);
+		for (int i = 0; i < upcomingCalls.size(); i++) {
+			if (upcomingCalls.get(i).chat.id == oldCall.chat.id) {
+				upcomingCalls.set(i, updated);
+				Collections.sort(upcomingCalls, (a, b) -> Integer.compare(a.date, b.date));
+				if (showingUpcomingCalls && listView != null) {
+					listView.adapter.update(true);
+				}
+				return;
+			}
+		}
+		if (isValidUpcomingCall(updated, getConnectionsManager().getCurrentTime())) {
+			upcomingCalls.add(updated);
+			Collections.sort(upcomingCalls, (a, b) -> Integer.compare(a.date, b.date));
+			if (showingUpcomingCalls && listView != null) {
+				listView.adapter.update(true);
+			}
+		}
+	}
+
+	private void removeUpcomingCall(long chatId) {
+		for (int i = upcomingCalls.size() - 1; i >= 0; i--) {
+			if (upcomingCalls.get(i).chat.id == chatId) {
+				upcomingCalls.remove(i);
+			}
+		}
+		if (showingUpcomingCalls && listView != null) {
+			listView.adapter.update(true);
+		}
+	}
