+    private void openOriginalTimeQuote(TimeQuoteStore.Quote quote, int fromMessageId) {
+        stopLocalQuotePlayback();
+        // select=true uses Telegram's own themed blue message highlight.
+        scrollToMessageId(quote.originalMessageId, fromMessageId, true, 0, true, 0);
+        final long deadline = android.os.SystemClock.uptimeMillis() + 15000;
+        localQuoteNavigation = new Runnable() {
+            @Override public void run() {
+                MessageObject original = messagesDict[0].get(quote.originalMessageId);
+                boolean visible = false;
+                if (original != null && chatListView != null) {
+                    for (int i = 0; i < chatListView.getChildCount(); i++) {
+                        View child = chatListView.getChildAt(i);
+                        if (child instanceof ChatMessageCell) {
+                            MessageObject object = ((ChatMessageCell) child).getMessageObject();
+                            if (object != null && object.getId() == quote.originalMessageId) {
+                                visible = true;
+                                break;
+                            }
+                        }
+                    }
+                }
+                if (visible) {
+                    localQuoteNavigation = null;
+                    highlightMessageId = original.getId();
+                    updateVisibleRows();
+                    startMessageUnselect();
+                    playLocalQuoteRange(original, quote.startMs, quote.endMs);
+                } else if (android.os.SystemClock.uptimeMillis() < deadline) {
+                    AndroidUtilities.runOnUIThread(this, 100);
+                } else {
+                    localQuoteNavigation = null;
+                }
+            }
+        };
+        AndroidUtilities.runOnUIThread(localQuoteNavigation, 100);
+    }
+
+    private boolean playLocalQuoteRange(MessageObject object, long start, long end) {
+        stopLocalQuotePlayback();
+        if (end <= start) return false;
+        MediaController media = MediaController.getInstance();
+        object.audioProgress = object.getDuration() > 0 ? (float) (start / (object.getDuration() * 1000.0)) : 0;
+        object.audioProgressMs = (int) start;
+        if (!media.playMessage(object)) return false;
+        if (org.telegram.ui.TimeQuote.TimeQuoteLocalMessage.isExpandedVideo(object) && media.getVideoPlayer() != null) {
+            media.getVideoPlayer().setPlaybackSpeed(media.getPlaybackSpeed(false));
+        }
+        media.setVoiceMessagesPlaylist(null, false);
+        localQuotePlaying = object;
+        localQuotePlaybackTick = new Runnable() {
+            // Millisecond seeking also works before ExoPlayer knows the duration.
+            // Retry only if the original is still being downloaded (no player yet).
+            boolean sought = media.seekToProgressMs(object, start);
+            boolean rangeEnded;
+            @Override public void run() {
+                MessageObject playing = media.getPlayingMessageObject();
+                if (playing == null || playing.getId() != object.getId()
+                        || playing.getDialogId() != object.getDialogId()) return;
+                if (!sought) sought = media.seekToProgressMs(object, start);
+                long position = media.getProgressMs(object);
+                if (rangeEnded) {
+                    // The native top panel can resume playback without calling the cell.
+                    if (!media.isMessagePaused()) {
+                        media.seekToProgressMs(object, start);
+                        rangeEnded = false;
+                    }
+                } else if (sought && position >= end) {
+                    media.pauseMessage(object);
+                    media.seekToProgressMs(object, end);
+                    rangeEnded = true;
+                } else if (sought && position >= 0 && position < start - 100) {
+                    media.seekToProgressMs(object, start);
+                }
+                AndroidUtilities.runOnUIThread(this, media.isMessagePaused() ? 80 : 20);
+            }
+        };
+        AndroidUtilities.runOnUIThread(localQuotePlaybackTick, 20);
+        return true;
+    }
+
+    private void stopLocalQuotePlayback() {
+        if (localQuoteNavigation != null) AndroidUtilities.cancelRunOnUIThread(localQuoteNavigation);
+        localQuoteNavigation = null;
+        if (localQuotePlaybackTick != null) AndroidUtilities.cancelRunOnUIThread(localQuotePlaybackTick);
+        localQuotePlaybackTick = null;
+        MediaController media = MediaController.getInstance();
+        MessageObject playing = media.getPlayingMessageObject();
+        if (localQuotePlaying != null && playing != null
+                && playing.getId() == localQuotePlaying.getId()
+                && playing.getDialogId() == localQuotePlaying.getDialogId()) {
+            if (media.isDownloadingCurrentMessage()) media.cleanupPlayer(true, true);
+            else media.pauseMessage(playing);
+        }
+        localQuotePlaying = null;
+    }
