+            return;
+        }
+        if (downloadListener != null && waitingMessage == message && fileName.equals(waitingFileName)) {
+            return; // Keep observing the same ongoing download.
+        }
+        close();
+        waitingMessage = message;
+        waitingFileName = fileName;
+        originalComposer.setVisibility(View.INVISIBLE);
+        attachOverlay();
+        LinearLayout bar = new LinearLayout(activity);
+        bar.setGravity(Gravity.CENTER_VERTICAL);
