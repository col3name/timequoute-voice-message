+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.nio.ByteBuffer;
+
+/** Export a physically independent clip; never modifies the source file. */
+public final class TimeQuoteExporter {
+    private TimeQuoteExporter() {}
+
+    public static long durationMs(File file) throws Exception {
+        MediaMetadataRetriever mr = new MediaMetadataRetriever();
+        try {
+            mr.setDataSource(file.getAbsolutePath());
+            String s = mr.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION);
+            if (s == null) throw new IOException("Unknown media duration");
+            return Long.parseLong(s);
+        } finally { mr.release(); }
+    }
+
+    public static File export(File source, File clipsDir, boolean circle, long startMs, long endMs) throws Exception {
+        if (!source.isFile()) throw new IOException("Original file is not downloaded");
+        long duration = durationMs(source);
+        if (startMs < 0 || endMs > duration + 20 || endMs - startMs < Math.min(300, duration)) {
+            throw new IllegalArgumentException("Invalid interval");
+        }
+        if (!clipsDir.isDirectory() && !clipsDir.mkdirs()) throw new IOException("Cannot create clips directory");
+        File target = new File(clipsDir, java.util.UUID.randomUUID() + (circle ? ".mp4" : ".wav"));
+        File partial = new File(clipsDir, java.util.UUID.randomUUID() + ".partial" + (circle ? ".mp4" : ".wav"));
+        try {
+            if (circle) clipMp4(source, partial, startMs, endMs);
+            else if (TimeQuotePcmWav.supported(source)) TimeQuotePcmWav.copy(source, partial, startMs, endMs);
+            else clipPcmToWav(source, partial, startMs, endMs);
+            if (!partial.isFile() || partial.length() < 48) throw new IOException("Empty export");
+            long clipMs = durationMs(partial);
+            if (clipMs < 80 || clipMs > endMs - startMs + 1200) throw new IOException("Invalid exported duration: " + clipMs);
+            if (!partial.renameTo(target)) throw new IOException("Could not finalize clip");
+            return target;
+        } catch (Exception ex) {
+            partial.delete();
+            target.delete();
+            throw ex;
+        }
+    }
+
+    /** Demo video is an independent source copy. Playback applies the saved range. */
+    public static File exportDemo(File source, File clipsDir, boolean circle,
+                                  long startMs, long endMs) throws Exception {
+        if (!circle) return export(source, clipsDir, false, startMs, endMs);
+        long duration = durationMs(source);
+        if (startMs < 0 || endMs > duration || endMs <= startMs) {
+            throw new IOException("Invalid video interval");
+        }
+        if (!clipsDir.isDirectory() && !clipsDir.mkdirs()) throw new IOException("Cannot create clips directory");
+        File target = new File(clipsDir, java.util.UUID.randomUUID() + ".mp4");
+        try (java.io.FileInputStream in = new java.io.FileInputStream(source);
+             java.io.FileOutputStream out = new java.io.FileOutputStream(target)) {
+            byte[] buffer = new byte[65536];
+            int count;
+            while ((count = in.read(buffer)) != -1) out.write(buffer, 0, count);
+            out.getFD().sync();
+        } catch (Exception error) {
+            target.delete();
+            throw error;
+        }
+        return target;
+    }
+
+    private static int audioTrack(MediaExtractor ex) {
+        for (int i = 0; i < ex.getTrackCount(); i++) {
+            String mime = ex.getTrackFormat(i).getString(MediaFormat.KEY_MIME);
+            if (mime != null && mime.startsWith("audio/")) return i;
+        }
+        return -1;
+    }
+
+    /** Decodes Telegram's Opus/OGG and AAC, as well as PCM-supported source formats, to real PCM WAV. */
+    private static void clipPcmToWav(File source, File target, long startMs, long endMs) throws Exception {
+        MediaExtractor ex = new MediaExtractor();
+        MediaCodec codec = null;
+        RandomAccessFile out = null;
+        try {
+            ex.setDataSource(source.getAbsolutePath());
+            int track = audioTrack(ex);
+            if (track < 0) throw new IOException("No audio track");
+            ex.selectTrack(track);
+            MediaFormat format = ex.getTrackFormat(track);
+            String mime = format.getString(MediaFormat.KEY_MIME);
+            codec = MediaCodec.createDecoderByType(mime);
+            if (Build.VERSION.SDK_INT >= 24) {
+                format.setInteger(MediaFormat.KEY_PCM_ENCODING, AudioFormat.ENCODING_PCM_16BIT);
+            }
+            codec.configure(format, null, null, 0);
+            codec.start();
+            int channels = format.containsKey(MediaFormat.KEY_CHANNEL_COUNT) ? format.getInteger(MediaFormat.KEY_CHANNEL_COUNT) : 1;
+            int sampleRate = format.containsKey(MediaFormat.KEY_SAMPLE_RATE) ? format.getInteger(MediaFormat.KEY_SAMPLE_RATE) : 48000;
+            out = new RandomAccessFile(target, "rw");
+            out.setLength(0);
+            out.write(new byte[44]);
+            MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+            boolean inputDone = false, outputDone = false;
+            long bytesWritten = 0;
+            while (!outputDone) {
+                if (!inputDone) {
+                    int idx = codec.dequeueInputBuffer(10000);
+                    if (idx >= 0) {
+                        ByteBuffer buffer = codec.getInputBuffer(idx);
+                        if (buffer == null) throw new IOException("Decoder input buffer missing");
+                        buffer.clear();
+                        int size = ex.readSampleData(buffer, 0);
+                        if (size < 0) {
+                            codec.queueInputBuffer(idx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                            inputDone = true;
+                        } else {
+                            codec.queueInputBuffer(idx, 0, size, ex.getSampleTime(), 0);
+                            ex.advance();
+                        }
+                    }
+                }
+                int idx = codec.dequeueOutputBuffer(info, 10000);
+                if (idx == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                    MediaFormat pcm = codec.getOutputFormat();
+                    sampleRate = pcm.getInteger(MediaFormat.KEY_SAMPLE_RATE);
+                    channels = pcm.getInteger(MediaFormat.KEY_CHANNEL_COUNT);
+                    if (pcm.containsKey(MediaFormat.KEY_PCM_ENCODING) && pcm.getInteger(MediaFormat.KEY_PCM_ENCODING) != AudioFormat.ENCODING_PCM_16BIT) {
+                        throw new IOException("Audio decoder does not output 16-bit PCM");
+                    }
+                } else if (idx >= 0) {
+                    if (info.size > 0) {
+                        ByteBuffer pcm = codec.getOutputBuffer(idx);
+                        if (pcm == null) throw new IOException("Decoder output missing");
+                        int frameBytes = channels * 2;
+                        long startFrame = (startMs * sampleRate) / 1000;
+                        long endFrame = (endMs * sampleRate) / 1000;
+                        long firstFrame = info.presentationTimeUs * sampleRate / 1_000_000L;
+                        long frames = info.size / frameBytes;
+                        long left = Math.max(0, startFrame - firstFrame);
+                        long right = Math.min(frames, endFrame - firstFrame);
+                        if (right > left) {
+                            int pos = info.offset + (int) (left * frameBytes);
+                            int n = (int) ((right - left) * frameBytes);
+                            byte[] bytes = new byte[n];
+                            pcm.position(pos);
+                            pcm.get(bytes);
+                            out.write(bytes);
+                            bytesWritten += n;
+                        }
+                    }
+                    outputDone = (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0;
+                    codec.releaseOutputBuffer(idx, false);
+                }
+            }
+            if (bytesWritten == 0) throw new IOException("Audio selection produced no PCM samples");
+            writeWavHeader(out, channels, sampleRate, bytesWritten);
+        } finally {
+            if (out != null) out.close();
+            if (codec != null) { try { codec.stop(); } catch (Exception ignore) {} codec.release(); }
+            ex.release();
+        }
+    }
+
+    private static void put16(RandomAccessFile out, int value) throws IOException {
+        out.writeByte(value & 255); out.writeByte((value >>> 8) & 255);
+    }
+    private static void put32(RandomAccessFile out, long value) throws IOException {
+        for (int i = 0; i < 4; i++) out.writeByte((int) (value >>> (i * 8)) & 255);
+    }
+    static void writeWavHeader(RandomAccessFile f, int channels, int rate, long size) throws IOException {
+        if (size > 0xFFFFFFFFL - 36) throw new IOException("WAV size limit");
+        f.seek(0); f.writeBytes("RIFF"); put32(f, size + 36); f.writeBytes("WAVE");
+        f.writeBytes("fmt "); put32(f, 16); put16(f, 1); put16(f, channels);
+        put32(f, rate); put32(f, (long)rate * channels * 2); put16(f, channels * 2); put16(f, 16);
+        f.writeBytes("data"); put32(f, size);
+    }
+
+    /**
+     * Frame-accurate trim for Telegram video messages. Long-GOP MP4 videos may
+     * contain no sync frame within a short selected interval. Always decode
+     * from the preceding sync frame and re-encode starting at startMs instead
+     * of dropping the leading seconds (or failing on SEEK_TO_NEXT_SYNC).
+     *
+     * This uses Telegram's existing hardware-backed MediaCodecVideoConvertor.
+     * startTime/endTime/duration are in MICROSECONDS in that API.
+     */
+    private static void clipMp4(File source, File target, long startMs, long endMs) throws Exception {
+        MediaExtractor extractor = new MediaExtractor();
+        MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+        try {
+            extractor.setDataSource(source.getAbsolutePath());
+            int videoTrack = -1;
+            for (int i = 0; i < extractor.getTrackCount(); i++) {
+                MediaFormat format = extractor.getTrackFormat(i);
+                String mime = format.getString(MediaFormat.KEY_MIME);
+                if (mime != null && mime.startsWith("video/")) {
+                    videoTrack = i;
+                    break;
+                }
+            }
+            if (videoTrack < 0) throw new IOException("Video track not found");
+            MediaFormat inputFormat = extractor.getTrackFormat(videoTrack);
+            int width = inputFormat.getInteger(MediaFormat.KEY_WIDTH);
+            int height = inputFormat.getInteger(MediaFormat.KEY_HEIGHT);
+            if (width < 16 || height < 16) throw new IOException("Unsupported video dimensions");
+            int fps = inputFormat.containsKey(MediaFormat.KEY_FRAME_RATE)
+                    ? inputFormat.getInteger(MediaFormat.KEY_FRAME_RATE) : 30;
+            fps = Math.max(15, Math.min(fps, 59));
+            int sourceBitrate = inputFormat.containsKey(MediaFormat.KEY_BIT_RATE)
+                    ? inputFormat.getInteger(MediaFormat.KEY_BIT_RATE) : 0;
+            int bitrate = sourceBitrate > 0 ? sourceBitrate : 1_200_000;
+            bitrate = Math.max(300_000, Math.min(bitrate, 4_000_000));
+
+            retriever.setDataSource(source.getAbsolutePath());
+            String rotationString = retriever.extractMetadata(
+                    MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION);
+            int rotation = rotationString == null ? 0 : Integer.parseInt(rotationString);
+            if (rotation != 0 && rotation != 90 && rotation != 180 && rotation != 270) rotation = 0;
+
+            long startUs = startMs * 1000L;
+            long endUs = endMs * 1000L;
+            long durationUs = endUs - startUs;
+            if (durationUs <= 0) throw new IOException("Invalid video interval");
+
+            org.telegram.messenger.VideoEditedInfo edit =
+                    new org.telegram.messenger.VideoEditedInfo();
+            edit.originalPath = source.getAbsolutePath();
+            edit.startTime = startUs;
+            edit.endTime = endUs;
+            edit.originalDuration = durationMs(source) * 1000L;
+            edit.originalWidth = width;
+            edit.originalHeight = height;
+            edit.resultWidth = width;
+            edit.resultHeight = height;
+            edit.framerate = fps;
+            edit.bitrate = bitrate;
+            edit.originalBitrate = sourceBitrate;
+            edit.rotationValue = rotation;
+            edit.roundVideo = true;
+            edit.muted = false;
+            edit.volume = 1f;
+
+            // Mirrors MediaController.convertVideo's dimension handling.
+            int outputWidth = width;
+            int outputHeight = height;
+            if (rotation == 90 || rotation == 270) {
+                outputWidth = height;
+                outputHeight = width;
+            }
+
+            org.telegram.messenger.MediaController.VideoConvertorListener callback =
+                    new org.telegram.messenger.MediaController.VideoConvertorListener() {
+                        @Override public boolean checkConversionCanceled() { return false; }
+                        @Override public void didWriteData(long size, float progress) { }
+                    };
+            org.telegram.messenger.video.MediaCodecVideoConvertor.ConvertVideoParams params =
+                    org.telegram.messenger.video.MediaCodecVideoConvertor.ConvertVideoParams.of(
+                            source.getAbsolutePath(), target, 0L, rotation, false,
+                            width, height, outputWidth, outputHeight,
+                            fps, bitrate, sourceBitrate,
+                            startUs, endUs, -1L, true, durationUs, callback, edit);
+            // Otherwise the stock fast AAC copy may include pre-roll audio frames.
+            params.forceReencodeAudio = true;
+            params.timeQuoteExport = true;
+            android.util.Log.d("TimeQuote", "video transcode: " + startMs + "-" + endMs
+                    + " ms, " + width + "x" + height + " fps=" + fps);
+            org.telegram.messenger.video.MediaCodecVideoConvertor converter =
+                    new org.telegram.messenger.video.MediaCodecVideoConvertor();
+            boolean failed = converter.convertVideo(params);
+            if (failed || !target.isFile() || target.length() < 48) {
+                Throwable codecError = converter.getTimeQuoteLastError();
+                String reason = codecError == null
+                        ? "native converter returned failure without an exception; check codec logs"
+                        : codecError.getClass().getSimpleName() + ": " + codecError.getMessage();
+                android.util.Log.e("TimeQuote", "Video transcode failed: " + reason
+                        + " (source=" + source.length() + " bytes, output="
+                        + (target.isFile() ? target.length() : -1L) + " bytes)", codecError);
+                throw new IOException("Video transcoding failed: " + reason, codecError);
+            }
+            android.util.Log.d("TimeQuote", "video transcode completed: "
+                    + target.length() + " bytes");
+        } finally {
+            retriever.release();
+            extractor.release();
+        }
+    }
+}
