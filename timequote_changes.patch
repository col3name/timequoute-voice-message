+    private void reloadLocalTimeQuotes() {
+        if (getParentActivity() == null || chatMode != 0) return;
+        TimeQuoteStore store = new TimeQuoteStore(getParentActivity(), currentAccount);
+        for (TimeQuoteStore.Quote quote : store.load()) {
+            if (quote.dialogId != dialog_id) continue;
+            if (quote.localMessageId == 0) quote.localMessageId = -1000000000 - (quote.id.hashCode() & 0x1fffffff);
+            if (quote.date == 0) quote.date = (int) (store.clipFile(quote).lastModified() / 1000);
+            if (localTimeQuotes.containsKey(quote.localMessageId)) continue;
+            MessageObject original = messagesDict[0].get(quote.originalMessageId);
+            MessageObject object = org.telegram.ui.TimeQuote.TimeQuoteLocalMessage.create(
+                    currentAccount, quote, original, store.clipFile(quote));
+            object.stableId = lastStableId++;
+            localTimeQuotes.put(quote.localMessageId, quote);
+            localTimeQuoteMessages.add(object);
+        }
+        if (chatAdapter != null) chatAdapter.notifyDataSetChanged();
+    }
+
+    /** Reconcile after history reloads; local demo objects never enter MessagesStorage. */
+    private void mergeLocalTimeQuotes() {
+        for (MessageObject object : localTimeQuoteMessages) {
+            MessageObject original = messagesDict[0].get(localTimeQuotes.get(object.getId()).originalMessageId);
+            if (original != null) object.replyMessageObject = original;
+            if (messages.contains(object)) continue;
+            ArrayList<MessageObject> day = messagesByDays.get(object.dateKey);
+            int at = 0;
+            while (at < messages.size() && messages.get(at).messageOwner.date > object.messageOwner.date) at++;
+            if (day == null) {
+                day = new ArrayList<>();
+                messagesByDays.put(object.dateKey, day);
+                messagesByDaysSorted.put(object.dateKeyInt, day);
+                TLRPC.Message date = new TLRPC.TL_message();
+                Calendar calendar = Calendar.getInstance();
+                calendar.setTimeInMillis(object.messageOwner.date * 1000L);
+                calendar.set(Calendar.HOUR_OF_DAY, 0);
+                calendar.set(Calendar.MINUTE, 0);
+                calendar.set(Calendar.SECOND, 0);
+                calendar.set(Calendar.MILLISECOND, 0);
+                date.date = (int) (calendar.getTimeInMillis() / 1000);
+                date.message = LocaleController.formatDateChat(date.date);
+                MessageObject dateObject = new MessageObject(currentAccount, date, false, false);
+                dateObject.type = MessageObject.TYPE_DATE;
+                dateObject.contentType = 1;
+                dateObject.isDateObject = true;
+                dateObject.stableId = getStableIdForDateObject(object.dateKeyInt);
+                messages.add(at, dateObject);
+            }
+            day.add(object);
+            messages.add(at, object);
+            messagesDict[0].put(object.getId(), object);
+        }
+    }
