+    private void previewAt(long timeMs) {
+        try {
+            ensurePlayer();
+            player.seekTo((int) Math.max(startMs, Math.min(endMs, timeMs)));
+            if (timeline != null) timeline.setPlaybackState(player.isPlaying(), timeMs);
+            if (previewSurface != null) previewSurface.setVisibility(View.VISIBLE);
+        } catch (Exception ignored) {}
+    }
+
+    private void ensurePlayer() throws Exception {
+        if (player != null) return;
+        player = new MediaPlayer();
+        player.setDataSource(source.getAbsolutePath());
+        player.prepare();
+        player.seekTo((int)startMs);
+        if (previewSurface != null) {
+            previewSurface.setSurfaceTextureListener(new TextureView.SurfaceTextureListener() {
+                @Override public void onSurfaceTextureAvailable(SurfaceTexture texture, int w, int h) {
+                    if (player != null) { Surface s = new Surface(texture); player.setSurface(s); s.release(); }
+                }
+                @Override public void onSurfaceTextureSizeChanged(SurfaceTexture texture, int w, int h) {}
+                @Override public boolean onSurfaceTextureDestroyed(SurfaceTexture texture) { return true; }
+                @Override public void onSurfaceTextureUpdated(SurfaceTexture texture) {}
+            });
+            if (previewSurface.isAvailable()) {
+                Surface s = new Surface(previewSurface.getSurfaceTexture()); player.setSurface(s); s.release();
+            }
+        }
+        player.setOnCompletionListener(mp -> stopPlayer());
+    }
+    private void togglePlay() {
+        try {
+            ensurePlayer();
+            if (player.isPlaying()) {
+                player.pause();
+                handler.removeCallbacks(tick);
+                if (timeline != null) timeline.setPlaybackState(false, player.getCurrentPosition());
+                return;
+            }
+            int position = player.getCurrentPosition();
+            if (position < startMs || position >= endMs) player.seekTo((int)startMs);
+            player.setPlaybackParams(new PlaybackParams().setSpeed(speed));
+            player.start();
+            if (previewSurface != null) previewSurface.setVisibility(View.VISIBLE);
+            if (timeline != null) timeline.setPlaybackState(true, player.getCurrentPosition());
+            handler.removeCallbacks(tick); handler.post(tick);
+        } catch (Exception ex) { Toast.makeText(activity, ex.getMessage(), Toast.LENGTH_LONG).show(); }
+    }
+    private final Runnable tick = new Runnable() {
+        @Override public void run() {
+            if (player == null) return;
+            if (player.getCurrentPosition() >= endMs) { stopPlayer(); return; }
+            if (timeline != null) timeline.setPlaybackState(player.isPlaying(), player.getCurrentPosition());
+            if (player.isPlaying()) handler.postDelayed(this, 80);
+        }
+    };
+    private void stopPlayer() {
+        handler.removeCallbacks(tick);
+        if (player != null) { try { player.stop(); } catch (Exception ignored) {} player.release(); player = null; }
+        if (playButton != null) playButton.setText("▶  Прослушать фрагмент");
+        if (timeline != null) timeline.setPlaybackState(false, startMs);
+        if (previewSurface != null) previewSurface.setVisibility(View.INVISIBLE);
+    }
+    private void hideKeyboard() {
+        if (text != null) {
+            InputMethodManager imm = (InputMethodManager) activity.getSystemService(Context.INPUT_METHOD_SERVICE);
+            if (imm != null) imm.hideSoftInputFromWindow(text.getWindowToken(), 0);
+        }
+    }
+    public void close() {
+        exportGeneration++;
+        busy = false;
+        pendingNativeReply = false;
+        detachDownloadObserver();
+        hideKeyboard(); stopPlayer();
+        if (globalLayoutListener != null) {
+            View decor = activity.getWindow().getDecorView();
+            if (decor.getViewTreeObserver().isAlive()) {
+                decor.getViewTreeObserver().removeOnGlobalLayoutListener(globalLayoutListener);
+            }
+            globalLayoutListener = null;
+        }
+        if (overlay != null) {
+            if (overlay.getParent() instanceof ViewGroup) {
+                ((ViewGroup) overlay.getParent()).removeView(overlay);
+            }
+            overlay = null;
+        }
+        overlayHost = null;
+        bottomBar = null;
+        lastBottomMargin = -1;
+        originalComposer.setVisibility(View.VISIBLE);
+        originalComposer.checkSendButton(false);
+        panel = null;
+        previewSurface = null; timeline = null; playButton = null; text = null;
+    }
+}
