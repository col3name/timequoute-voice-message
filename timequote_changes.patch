+    private void toggleInlineTimeQuote(ChatMessageCell cell, TimeQuoteStore.Quote quote) {
+        MessageObject old = cell.getMessageObject();
+        boolean expand = !org.telegram.ui.TimeQuote.TimeQuoteLocalMessage.isExpanded(old);
+        try {
+            TimeQuoteStore store = new TimeQuoteStore(getParentActivity(), currentAccount);
+            MessageObject replacement = org.telegram.ui.TimeQuote.TimeQuoteLocalMessage.create(
+                    currentAccount, quote, old.replyMessageObject, store.clipFile(quote), expand);
+            replacement.copyStableParams(old);
+            stopLocalQuotePlayback();
+            MessageObject playing = MediaController.getInstance().getPlayingMessageObject();
+            if (playing != null && playing.getId() == old.getId() && playing.getDialogId() == dialog_id) {
+                MediaController.getInstance().cleanupPlayer(true, true);
+            }
+            int index = localTimeQuoteMessages.indexOf(old);
+            if (index >= 0) localTimeQuoteMessages.set(index, replacement);
+            index = messages.indexOf(old);
+            if (index >= 0) messages.set(index, replacement);
+            ArrayList<MessageObject> day = messagesByDays.get(old.dateKey);
+            if (day != null && (index = day.indexOf(old)) >= 0) day.set(index, replacement);
+            messagesDict[0].put(replacement.getId(), replacement);
+            chatAdapter.notifyDataSetChanged();
+            chatListView.post(() -> {
+                if (paused || messagesDict[0].get(replacement.getId()) != replacement) return;
+                scrollToMessageId(replacement.getId(), 0, false, 0, true, 0);
+                if (expand) playInlineTimeQuote(replacement, quote);
+            });
+        } catch (Exception error) {
+            FileLog.e(error);
+            android.widget.Toast.makeText(getParentActivity(), error.getMessage(), android.widget.Toast.LENGTH_SHORT).show();
+        }
+    }
