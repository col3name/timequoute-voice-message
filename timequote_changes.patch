@@ -0,0 +1,104 @@
+package org.telegram.ui.TimeQuote;
+
+import android.content.Context;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.UUID;
+
+/** Per-installation metadata only. Server messages are owned by Telegram. */
+public final class TimeQuoteStore {
+    public static final class Quote {
+        public String id = UUID.randomUUID().toString();
+        public long dialogId;
+        public int originalMessageId;
+        public int localMessageId, date;
+        public String kind;
+        public long startMs, endMs;
+        public String text, clipFileName, sourcePath;
+        public byte[] waveform;
+        public JSONObject json() throws Exception {
+            JSONObject j = new JSONObject();
+            if (waveform != null) j.put("waveform", android.util.Base64.encodeToString(waveform, android.util.Base64.NO_WRAP));
+            j.put("localMessageId", localMessageId).put("date", date);
+            j.put("id", id).put("dialogId", dialogId).put("messageId", originalMessageId)
+                    .put("kind", kind).put("startMs", startMs).put("endMs", endMs)
+                    .put("sourcePath", sourcePath).put("text", text == null ? "" : text).put("clipFileName", clipFileName);
+            return j;
+        }
+        public static Quote fromJson(JSONObject j) throws Exception {
+            Quote q = new Quote();
+            q.localMessageId = j.optInt("localMessageId"); q.date = j.optInt("date");
+            q.id = j.getString("id"); q.dialogId = j.optLong("dialogId");
+            q.originalMessageId = j.getInt("messageId"); q.kind = j.getString("kind");
+            q.startMs = j.getLong("startMs"); q.endMs = j.getLong("endMs");
+            String waveform = j.optString("waveform");
+            if (!waveform.isEmpty()) {
+                try { q.waveform = android.util.Base64.decode(waveform, android.util.Base64.DEFAULT); }
+                catch (IllegalArgumentException ignored) { }
+            }
+            q.sourcePath = j.optString("sourcePath"); q.text = j.optString("text"); q.clipFileName = j.getString("clipFileName");
+            return q;
+        }
+    }
+
+    private final File dir, clips, file;
+    public TimeQuoteStore(Context context, int account) {
+        dir = new File(context.getFilesDir(), "TimeQuote/" + account);
+        clips = new File(dir, "Clips");
+        clips.mkdirs(); file = new File(dir, "sent_quotes.json");
+    }
+    public File clipsDir() { return clips; }
+    public File clipFile(Quote q) { return new File(clips, q.clipFileName); }
+    public synchronized ArrayList<Quote> load() {
+        ArrayList<Quote> result = new ArrayList<>();
+        if (!file.isFile()) return result;
+        try (FileInputStream in = new FileInputStream(file)) {
+            byte[] bytes = new byte[(int) file.length()];
+            int at = 0, n;
+            while (at < bytes.length && (n = in.read(bytes, at, bytes.length - at)) > 0) at += n;
+            JSONArray array = new JSONArray(new String(bytes, 0, at, StandardCharsets.UTF_8));
+            for (int i = 0; i < array.length(); i++) {
+                Quote q = Quote.fromJson(array.getJSONObject(i));
+                if (clipFile(q).isFile()) result.add(q);
+            }
+        } catch (Exception ignored) { /* corrupted file must not crash chat */ }
+        return result;
+    }
+    public synchronized void add(Quote q) throws Exception {
+        ArrayList<Quote> entries = load();
+        entries.add(q);
+        save(entries);
+    }
+    public synchronized void remove(String id) throws Exception {
+        ArrayList<Quote> entries = load();
+        Quote removed = null;
+        for (int i = entries.size() - 1; i >= 0; i--) {
+            if (entries.get(i).id.equals(id)) removed = entries.remove(i);
+        }
+        save(entries);
+        if (removed != null) clipFile(removed).delete();
+    }
+    private void save(ArrayList<Quote> entries) throws Exception {
+        JSONArray data = new JSONArray();
+        for (Quote item : entries) data.put(item.json());
+        File temp = new File(dir, "sent_quotes.json.tmp");
+        try (FileOutputStream out = new FileOutputStream(temp)) {
+            out.write(data.toString(2).getBytes(StandardCharsets.UTF_8));
+            out.getFD().sync();
+        }
+        if (!temp.renameTo(file)) throw new java.io.IOException("Could not save metadata");
+    }
+    public Quote lastRange(long dialogId, int originalMessageId) {
+        ArrayList<Quote> list = load();
+        for (int i = list.size() - 1; i >= 0; i--) {
+            Quote q = list.get(i);
+            if (q.dialogId == dialogId && q.originalMessageId == originalMessageId) return q;
+        }
+        return null;
+    }
+}
