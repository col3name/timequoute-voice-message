+    private boolean playInlineTimeQuote(MessageObject message, TimeQuoteStore.Quote quote) {
+        MediaController media = MediaController.getInstance();
+        long start = "circle".equals(quote.kind) ? quote.startMs : 0;
+        long end = "circle".equals(quote.kind) ? quote.endMs : quote.endMs - quote.startMs;
+        if (media.isPlayingMessage(message)) {
+            if (!media.isMessagePaused()) return media.pauseMessage(message);
+            long position = media.getProgressMs(message);
+            if (position >= start && position < end) return media.playMessage(message);
+        }
+        return playLocalQuoteRange(message, start, end);
+    }
