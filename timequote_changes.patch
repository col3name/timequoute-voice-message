+    private int dp(int n) { return (int) (activity.getResources().getDisplayMetrics().density * n + .5f); }
+    private GradientDrawable bg(int color, int radius) {
+        GradientDrawable d = new GradientDrawable(); d.setColor(color); d.setCornerRadius(dp(radius)); return d;
+    }
+    private TextView label(String s, int size, int color) {
+        TextView v = new TextView(activity);
+        v.setText(s); v.setTextSize(size); v.setTextColor(color);
+        v.setGravity(Gravity.CENTER_VERTICAL); return v;
+    }
+    private TextView action(String s, Runnable onClick) {
+        TextView v = label(s, 15, Color.WHITE);
+        v.setGravity(Gravity.CENTER); v.setBackground(bg(0xff348be8, 22));
+        v.setOnClickListener(w -> onClick.run()); return v;
+    }
+    /**
+     * The Telegram Activity may draw edge-to-edge. A bar using Gravity.BOTTOM with
+     * an 8dp margin alone can be BEHIND the Android nav bar or the IME.
+     *
+     * Place the overlay in the Activity content as before, then calculate the
+     * bottom margin from the real safe screen rectangle, in host coordinates.
+     * Avoid installing an insets listener on Telegram's existing root view,
+     * because that would replace its own insets logic.
+     */
+    private void attachOverlay() {
+        FrameLayout host = activity.findViewById(android.R.id.content);
+        if (host == null) host = root;
+        overlayHost = host;
+        lastBottomMargin = -1;
+        bottomBar = null;
+        overlay = new FrameLayout(activity);
+        overlay.setClickable(false);
+        overlay.setFocusable(false);
+        overlay.setClipChildren(false);
+        overlay.setElevation(dp(32));
+        host.addView(overlay, new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT));
+        overlay.bringToFront();
+
+        // Updates when the keyboard appears or when Telegram resizes its content.
+        overlay.setOnApplyWindowInsetsListener((v, insets) -> {
+            updateSafeBottom();
+            return insets; // Do not consume insets used by Telegram/Android.
+        });
+        overlay.addOnLayoutChangeListener((v, left, top, right, bottom,
+                oldLeft, oldTop, oldRight, oldBottom) -> updateSafeBottom());
+        final View decor = activity.getWindow().getDecorView();
+        globalLayoutListener = this::updateSafeBottom;
+        decor.getViewTreeObserver().addOnGlobalLayoutListener(globalLayoutListener);
+        overlay.post(() -> {
+            if (overlay == null) return;
+            overlay.requestApplyInsets();
+            updateSafeBottom();
+        });
+    }
+
+    /**
+     * System bar/keyboard insets are relative to the Window, not necessarily to
+     * android.R.id.content. Subtract only the part actually overlapping the host.
+     * This prevents double padding on non edge-to-edge Android versions.
+     */
+    private void updateSafeBottom() {
+        if (overlayHost == null || bottomBar == null || overlay == null
+                || bottomBar.getParent() != overlay || overlayHost.getHeight() <= 0) return;
+        View decor = activity.getWindow().getDecorView();
+        int[] hostPos = new int[2], decorPos = new int[2];
+        overlayHost.getLocationOnScreen(hostPos);
+        decor.getLocationOnScreen(decorPos);
+        int hostBottom = hostPos[1] + overlayHost.getHeight();
+        int decorBottom = decorPos[1] + decor.getHeight();
+        int safeBottom = decorBottom;
+
+        if (Build.VERSION.SDK_INT >= 30) {
+            WindowInsets insets = decor.getRootWindowInsets();
+            if (insets != null) {
+                int bottom = insets.getInsets(WindowInsets.Type.navigationBars()
+                        | WindowInsets.Type.ime()).bottom;
+                safeBottom = Math.min(safeBottom, decorBottom - bottom);
+            }
