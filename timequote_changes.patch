@@ -0,0 +1,124 @@
+package org.telegram.ui.TimeQuote;
+
+import android.text.SpannableStringBuilder;
+import java.io.File;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.TLRPC;
+
+/** A native compact quote with optional media expanded inside the same cell. */
+public final class TimeQuoteLocalMessage {
+    private static final class QuoteMessage extends MessageObject {
+        final boolean expanded;
+        QuoteMessage(int account, TLRPC.Message message, boolean expanded) {
+            super(account, message, true, true);
+            this.expanded = expanded;
+        }
+
+        @Override public String getMusicAuthor() {
+            return replyMessageObject == null ? super.getMusicAuthor() : replyMessageObject.getMusicAuthor();
+        }
+        @Override public String getMusicTitle() {
+            return replyMessageObject == null ? super.getMusicTitle() : replyMessageObject.getMusicTitle();
+        }
+
+        @Override
+        public CharSequence getReplyQuoteNameWithIcon() {
+            CharSequence author = super.getReplyQuoteNameWithIcon();
+            return new SpannableStringBuilder("Reply to ").append(author == null ? "" : author);
+        }
+    }
+
+    public static MessageObject create(int account, TimeQuoteStore.Quote quote,
+                                       MessageObject original, File clip) {
+        return create(account, quote, original, clip, !"circle".equals(quote.kind));
+    }
+
+    public static boolean isExpanded(MessageObject message) {
+        return message instanceof QuoteMessage && ((QuoteMessage) message).expanded;
+    }
+
+    public static boolean isExpandedVideo(MessageObject message) {
+        return isExpanded(message) && message.isVideo();
+    }
+
+    public static MessageObject create(int account, TimeQuoteStore.Quote quote,
+                                       MessageObject original, File clip, boolean expanded) {
+        TLRPC.TL_message message = new TLRPC.TL_message();
+        message.id = quote.localMessageId;
+        message.date = quote.date;
+        message.dialog_id = quote.dialogId;
+        message.peer_id = MessagesController.getInstance(account).getPeer(quote.dialogId);
+        message.from_id = new TLRPC.TL_peerUser();
+        message.from_id.user_id = UserConfig.getInstance(account).getClientUserId();
+        message.out = true;
+        message.unread = false;
+        message.send_state = 0;
+        message.flags = TLRPC.MESSAGE_FLAG_HAS_FROM_ID | TLRPC.MESSAGE_FLAG_REPLY;
+        message.message = quote.text == null ? "" : quote.text;
+        message.reply_to = new TLRPC.TL_messageReplyHeader();
+        message.reply_to.flags = 16 | 64 | 512;
+        message.reply_to.reply_to_msg_id = quote.originalMessageId;
+        message.reply_to.quote = true;
+        boolean video = "circle".equals(quote.kind);
+        message.reply_to.quote_text = LocaleController.getString(video ? R.string.AttachRound : R.string.AttachAudio)
+                + " · " + TimeQuoteController.format(quote.startMs) + "–" + TimeQuoteController.format(quote.endMs);
+        // Voice quotes always contain their independently trimmed WAV.
+        expanded = expanded || !video;
+        if (expanded) {
+            if (clip == null || !clip.isFile()) throw new IllegalStateException("Saved quote media is missing");
+            TLRPC.TL_document document = new TLRPC.TL_document();
+            document.id = quote.localMessageId;
+            document.file_reference = new byte[0];
+            document.date = quote.date;
+            document.size = clip.length();
+            document.mime_type = video ? "video/mp4" : "audio/wav";
+            if (video) {
+                TLRPC.TL_documentAttributeVideo attribute = new TLRPC.TL_documentAttributeVideo();
+                attribute.w = attribute.h = 384;
+                try { attribute.duration = TimeQuoteExporter.durationMs(clip) / 1000.0; }
+                catch (Exception ignored) { attribute.duration = quote.endMs / 1000.0; }
+                document.attributes.add(attribute);
+                android.media.MediaMetadataRetriever retriever = new android.media.MediaMetadataRetriever();
+                try {
+                    retriever.setDataSource(clip.getAbsolutePath());
+                    android.graphics.Bitmap frame = retriever.getFrameAtTime(quote.startMs * 1000,
+                            android.media.MediaMetadataRetriever.OPTION_CLOSEST_SYNC);
+                    if (frame != null) {
+                        TLRPC.PhotoSize thumb = org.telegram.messenger.ImageLoader.scaleAndSaveImage(
+                                null, frame, 384, 384, 85, false, true);
+                        if (thumb != null) { document.thumbs.add(thumb); document.flags |= 1; }
+                        frame.recycle();
+                    }
+                } catch (Exception ignored) {
+                    // Playback still uses the independent local MP4.
+                } finally { try { retriever.release(); } catch (Exception ignored) { } }
+            } else {
+                TLRPC.TL_documentAttributeAudio attribute = new TLRPC.TL_documentAttributeAudio();
+                attribute.voice = true;
+                attribute.duration = (int) Math.max(1, (quote.endMs - quote.startMs + 999) / 1000);
+                if (quote.waveform == null) {
+                    try { quote.waveform = TimeQuotePcmWav.packedWaveform(clip); }
+                    catch (Exception error) { org.telegram.messenger.FileLog.e(error); }
+                }
+                if (quote.waveform != null) {
+                    attribute.waveform = quote.waveform;
+                    attribute.flags |= 4;
+                }
+                document.attributes.add(attribute);
+            }
+            message.media = new TLRPC.TL_messageMediaDocument();
+            message.media.flags = 1;
+            message.media.document = document;
+            message.flags |= TLRPC.MESSAGE_FLAG_HAS_MEDIA;
+            message.attachPath = clip.getAbsolutePath();
+        }
+        MessageObject result = new QuoteMessage(account, message, expanded);
+        result.attachPathExists = result.mediaExists = expanded;
+        result.replyMessageObject = original;
+        return result;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/TimeQuote/TimeQuotePcmWav.java b/TMessagesProj/src/main/java/org/telegram/ui/TimeQuote/TimeQuotePcmWav.java
new file mode 100644
index 000000000..f1db3bebe
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/TimeQuote/TimeQuotePcmWav.java
@@ -0,0 +1,111 @@
+package org.telegram.ui.TimeQuote;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+
+/** Handle uncompressed 16-bit little-endian PCM WAV directly, without a MediaCodec decoder. */
+public final class TimeQuotePcmWav {
+    private TimeQuotePcmWav() {}
+    private static class Format {
+        int sampleRate, channels;
+        long dataOffset, dataSize;
+    }
+    private static int read16(RandomAccessFile r) throws IOException {
+        return r.readUnsignedByte() | (r.readUnsignedByte() << 8);
+    }
+    private static long read32(RandomAccessFile r) throws IOException {
+        return ((long) r.readUnsignedByte()) | ((long)r.readUnsignedByte() << 8)
+                | ((long)r.readUnsignedByte() << 16) | ((long)r.readUnsignedByte() << 24);
+    }
+    private static String tag(RandomAccessFile r) throws IOException {
+        byte[] tag = new byte[4]; r.readFully(tag);
+        return new String(tag, java.nio.charset.StandardCharsets.US_ASCII);
+    }
+    private static Format inspect(File file) throws IOException {
+        try (RandomAccessFile r = new RandomAccessFile(file, "r")) {
+            if (r.length() < 44 || !tag(r).equals("RIFF")) return null;
+            read32(r);
+            if (!tag(r).equals("WAVE")) return null;
+            Format f = new Format();
+            boolean pcm = false, data = false;
+            while (r.getFilePointer() + 8 <= r.length()) {
+                String key = tag(r); long size = read32(r), at = r.getFilePointer();
+                if (size > r.length() - at) break;
+                if ("fmt ".equals(key) && size >= 16) {
+                    int code = read16(r); f.channels = read16(r); f.sampleRate = (int)read32(r);
+                    read32(r); read16(r);
+                    int bits = read16(r);
+                    pcm = code == 1 && bits == 16 && f.channels >= 1 && f.channels <= 8 && f.sampleRate > 0;
+                } else if ("data".equals(key)) {
+                    f.dataOffset = at; f.dataSize = size; data = true;
+                }
+                long next = at + size + (size & 1L);
+                if (next <= at || next > r.length()) break;
+                r.seek(next);
+            }
+            return pcm && data ? f : null;
+        }
+    }
+    public static boolean supported(File source) {
+        try { return inspect(source) != null; } catch (Exception ex) { return false; }
+    }
+    public static void copy(File source, File output, long fromMs, long toMs) throws IOException {
+        Format f = inspect(source);
+        if (f == null) throw new IOException("Not 16-bit PCM WAV");
+        int frameBytes = f.channels * 2;
+        long first = Math.min(f.dataSize / frameBytes, fromMs * f.sampleRate / 1000);
+        long last = Math.min(f.dataSize / frameBytes, toMs * f.sampleRate / 1000);
+        if (last <= first) throw new IOException("Empty WAV interval");
+        long total = (last - first) * frameBytes;
+        try (RandomAccessFile input = new RandomAccessFile(source, "r");
+             RandomAccessFile dest = new RandomAccessFile(output, "rw")) {
+            dest.setLength(0); dest.write(new byte[44]);
+            input.seek(f.dataOffset + first * frameBytes);
+            byte[] buffer = new byte[16384]; long left = total;
+            while (left > 0) {
+                int n = (int)Math.min(left, buffer.length);
+                input.readFully(buffer, 0, n); dest.write(buffer, 0, n); left -= n;
+            }
+            TimeQuoteExporter.writeWavHeader(dest, f.channels, f.sampleRate, total);
+        }
+    }
+    public static float[] peaks(File source, int count) throws IOException {
+        Format f = inspect(source);
+        if (f == null) throw new IOException("Not 16-bit PCM WAV");
+        float[] values = new float[count];
+        long frames = f.dataSize / (f.channels * 2);
+        try (RandomAccessFile r = new RandomAccessFile(source, "r")) {
+            for (int i = 0; i < count; i++) {
+                long first = frames * i / count;
+                long last = frames * (i + 1) / count;
+                int max = 0;
+                long stride = Math.max(1L, (last-first) / 1000L);
+                for (long frame = first; frame < last; frame += stride) {
+                    r.seek(f.dataOffset + frame * f.channels * 2);
+                    int value = (short)read16(r);
+                    max = Math.max(max, Math.abs(value));
+                }
+                values[i] = Math.max(.06f, Math.min(1f, max / 32768f));
+            }
+        }
+        return values;
+    }
+    /** Telegram's 5-bit envelope, computed only from the independently trimmed WAV. */
+    public static byte[] packedWaveform(File clip) throws IOException {
+        float[] peaks = peaks(clip, 100);
+        float maximum = .01f;
+        for (float peak : peaks) maximum = Math.max(maximum, peak);
+        byte[] packed = new byte[(peaks.length * 5 + 7) / 8];
+        for (int i = 0; i < peaks.length; i++) {
+            int value = Math.min(31, Math.max(0, Math.round(peaks[i] / maximum * 31)));
+            int at = i * 5 / 8;
+            int shift = i * 5 % 8;
+            int remainder = Math.max(0, 5 - (8 - shift));
+            packed[at] |= (byte) ((value >> remainder) << shift);
+            if (remainder > 0) packed[at + 1] |= (byte) (value & ((1 << remainder) - 1));
+        }
+        return packed;
+    }
+
+}
