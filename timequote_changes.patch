+package org.telegram.ui.TimeQuote;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.util.TypedValue;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.media.MediaMetadataRetriever;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+
+import java.io.File;
+
+/**
+ * Telegram-style time selection inside the chat composer.
+ * White draggable handles adjust the selected interval; the blue area seeks;
+ * a central play/pause pill controls preview without adding another button row.
+ */
+public class TimeQuoteRangeView extends View {
+    public interface Listener {
+        void onChange(long startMs, long endMs);
+        void onSeek(long positionMs);
+        void onTogglePlay();
+    }
+
+    private static final int BLUE = 0xff1689fb;
+    private static final int WHITE = Color.WHITE;
+    private static final int MUTED = 0xff97a3ad;
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final RectF track = new RectF();
+    private final RectF playPill = new RectF();
+    private final int touchSlop;
+
+    private Listener listener;
+    private Bitmap[] frames;
+    private float[] waveform;
+    private long durationMs = 1, startMs, endMs = 1;
+    private long playbackMs;
+    private boolean video;
+    private boolean playing;
+    private int active = -1;
+    private float downX;
+    private boolean moved;
+    private int generation;
+
+    public TimeQuoteRangeView(Context context) {
+        super(context);
+        touchSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        setMinimumHeight(dp(60));
+        setClickable(true);
+        setContentDescription("Выбор начала и конца фрагмента");
+    }
+
+    private int dp(float n) {
+        return (int) (getResources().getDisplayMetrics().density * n + .5f);
+    }
+
+    public void setListener(Listener listener) { this.listener = listener; }
+
+    private static float[] unpackTelegramWaveform(byte[] data) {
+        int count = (data.length * 8) / 5;
+        if (count <= 0) return null;
+        float[] values = new float[count];
+        for (int i = 0; i < count; i++) {
+            int bit = i * 5;
+            int index = bit >> 3;
+            int shift = bit & 7;
+            int sample = ((data[index] & 0xff) >>> shift);
+            if (index + 1 < data.length) sample |= (data[index + 1] & 0xff) << (8 - shift);
+            values[i] = Math.min(31, sample & 31) / 31f;
+        }
+        return values;
+    }
+
+    public void configure(File source, boolean isVideo, long duration, long from, long to) {
+        configure(source, isVideo, duration, from, to, null);
+    }
+
+    public void configure(File source, boolean isVideo, long duration, long from, long to,
+                          byte[] telegramWaveform) {
+        video = isVideo;
+        durationMs = Math.max(1, duration);
+        long min = Math.min(300, durationMs);
+        startMs = clamp(from, 0, durationMs - min);
+        endMs = clamp(to, startMs + min, durationMs);
+        playbackMs = startMs;
+        playing = false;
+        waveform = null;
+        frames = null;
+        final int token = ++generation;
+        if (video) {
+            loadFrames(source, token);
+        } else if (telegramWaveform != null && telegramWaveform.length > 0) {
+            // Telegram stores voice bars as packed 5-bit amplitudes. Same source as
+            // SeekBarWaveform uses; no need to decode the entire OGG/Opus file.
+            waveform = unpackTelegramWaveform(telegramWaveform);
+        } else {
+            loadWaveform(source, token);
+        }
+        invalidate();
+    }
+
+    public long startMs() { return startMs; }
+    public long endMs() { return endMs; }
+
+    public void setPlaybackState(boolean playing, long positionMs) {
+        this.playing = playing;
+        this.playbackMs = clamp(positionMs, startMs, endMs);
+        invalidate();
+    }
+
+    private static long clamp(long v, long min, long max) {
+        return Math.max(min, Math.min(max, v));
+    }
+
+    private void loadFrames(File source, int token) {
+        new Thread(() -> {
+            Bitmap[] result = new Bitmap[12];
+            MediaMetadataRetriever retriever = new MediaMetadataRetriever();
+            try {
+                retriever.setDataSource(source.getAbsolutePath());
+                for (int i = 0; i < result.length; i++) {
+                    long timeUs = (long) (durationMs * (i + .5) / result.length * 1000);
+                    Bitmap bitmap = retriever.getFrameAtTime(timeUs,
+                            MediaMetadataRetriever.OPTION_CLOSEST_SYNC);
+                    if (bitmap != null) {
+                        int width = Math.max(1, dp(62));
+                        int height = Math.max(1, dp(50));
+                        Bitmap small = Bitmap.createScaledBitmap(bitmap, width, height, true);
+                        if (small != bitmap) bitmap.recycle();
+                        result[i] = small;
+                    }
+                }
+            } catch (Exception ignored) {
+            } finally {
+                try { retriever.release(); } catch (Exception ignored) { }
+            }
+            main.post(() -> {
+                if (token != generation) {
+                    recycle(result);
+                    return;
+                }
+                recycle(frames);
+                frames = result;
+                invalidate();
+            });
+        }, "TimeQuoteThumbs").start();
+    }
+
+    private static void recycle(Bitmap[] items) {
+        if (items == null) return;
+        for (Bitmap item : items) {
+            if (item != null && !item.isRecycled()) item.recycle();
+        }
+    }
+
+    private void loadWaveform(File source, int token) {
+        waveform = new float[160];
+        for (int i = 0; i < waveform.length; i++) waveform[i] = .20f;
+        new Thread(() -> {
+            try {
+                float[] peaks = TimeQuoteWaveform.compute(source, durationMs, 160);
+                main.post(() -> {
+                    if (token == generation) {
+                        waveform = peaks;
+                        invalidate();
+                    }
+                });
+            } catch (Exception ignored) { }
+        }, "TimeQuotePeaks").start();
+    }
+
+    private float left() { return video ? dp(8) : dp(3); }
+    private float width() { return Math.max(1, getWidth() - (video ? dp(16) : dp(6))); }
+    private float sp(float n) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, n,
+                getResources().getDisplayMetrics());
+    }
+    private float at(long ms) { return left() + width() * ms / (float) durationMs; }
+    private long at(float x) {
+        return (long) (durationMs * Math.max(0, Math.min(1, (x - left()) / width())));
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (!video) {
+            drawTelegramAudioRange(canvas);
+            return;
+        }
+        float top = dp(6);
+        float bottom = getHeight() - dp(21);
+        float radius = dp(12);
+        track.set(left(), top, left() + width(), bottom);
+
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(0x2395a7b5);
+        canvas.drawRoundRect(track, radius, radius, paint);
+
+        canvas.save();
+        canvas.clipRect(track);
+        if (video) drawThumbnails(canvas);
+        else drawWaveform(canvas, MUTED);
+        canvas.restore();
+
+        float selLeft = at(startMs);
+        float selRight = at(endMs);
+        RectF selected = new RectF(selLeft, top, selRight, bottom);
+        paint.setColor(BLUE);
+        paint.setAlpha(video ? 110 : 255);
+        canvas.drawRoundRect(selected, dp(10), dp(10), paint);
+        paint.setAlpha(255);
+
+        if (!video) {
+            canvas.save();
+            canvas.clipRect(selLeft, top, selRight, bottom);
+            drawWaveform(canvas, WHITE);
+            canvas.restore();
+        }
+
+        // White grabbers like Telegram's trimming/editor controls.
+        float handleWidth = dp(4.5f);
+        paint.setColor(WHITE);
+        canvas.drawRoundRect(selLeft - handleWidth / 2, top - dp(2),
+                selLeft + handleWidth / 2, bottom + dp(2), dp(2), dp(2), paint);
+        canvas.drawRoundRect(selRight - handleWidth / 2, top - dp(2),
+                selRight + handleWidth / 2, bottom + dp(2), dp(2), dp(2), paint);
+
+        // Current preview position, independently of the start/end handles.
+        if (playbackMs > startMs && playbackMs < endMs) {
+            float cursor = at(playbackMs);
+            paint.setColor(0xffc9ecff);
+            paint.setStrokeWidth(dp(1.6f));
+            canvas.drawLine(cursor, top + dp(3), cursor, bottom - dp(3), paint);
+        }
+
+        // Play/pause is embedded in the blue selection, as in the reference.
+        playPill.setEmpty();
+        float span = selRight - selLeft;
+        if (span >= dp(54)) {
+            float pillWidth = Math.min(span - dp(10), dp(85));
+            float cx = (selLeft + selRight) / 2;
+            float cy = (top + bottom) / 2;
+            playPill.set(cx - pillWidth / 2, cy - dp(13),
+                    cx + pillWidth / 2, cy + dp(13));
+            paint.setColor(0xdce7f4ff);
+            canvas.drawRoundRect(playPill, dp(16), dp(16), paint);
+            String label = playing ? "Ⅱ " : "▶ ";
+            if (pillWidth >= dp(67)) label += TimeQuoteController.format(Math.max(0, playbackMs - startMs));
+            paint.setColor(0xff20394e);
+            paint.setTextSize(dp(12));
+            paint.setFakeBoldText(true);
+            paint.setTextAlign(Paint.Align.CENTER);
+            canvas.drawText(label, cx, cy - (paint.ascent() + paint.descent()) / 2, paint);
+            paint.setFakeBoldText(false);
+            paint.setTextAlign(Paint.Align.LEFT);
+        }
+
+        paint.setColor(0xff7e8e9c);
+        paint.setTextSize(dp(10));
+        String from = TimeQuoteController.format(startMs);
+        String to = TimeQuoteController.format(endMs);
+        canvas.drawText(from, left(), getHeight() - dp(3), paint);
+        canvas.drawText(to, left() + width() - paint.measureText(to), getHeight() - dp(3), paint);
+    }
+
+    /**
+     * Audio-only track matching Telegram's voice selection composer:
+     * muted unselected waveform, blue range, light bars, two white handles,
+     * and a darker blue playback chip. No labels underneath the waveform.
+     */
+    private void drawTelegramAudioRange(Canvas canvas) {
+        float top = dp(1);
+        float bottom = getHeight() - dp(1);
+        float l = left();
+        float r = l + width();
+        float a = at(startMs);
+        float b = at(endMs);
+        track.set(l, top, r, bottom);
+
+        paint.setStyle(Paint.Style.FILL);
+        paint.setColor(0xffedf2f7);
+        canvas.drawRoundRect(track, dp(11), dp(11), paint);
+
+        // Mask all drawing to the rounded audio rail.
+        canvas.save();
+        Path outline = new Path();
+        outline.addRoundRect(track, dp(11), dp(11), Path.Direction.CW);
+        canvas.clipPath(outline);
+
+        drawAudioBars(canvas, 0xff8197aa);
+        RectF selected = new RectF(a, top, b, bottom);
+        paint.setColor(BLUE);
+        canvas.drawRoundRect(selected, dp(10), dp(10), paint);
+        canvas.save();
+        canvas.clipRect(a, top, b, bottom);
+        drawAudioBars(canvas, 0xffb5dcff);
+        canvas.restore();
+        canvas.restore();
+
+        // Darker blue edge caps, with the thin white strokes visible in the screenshot.
+        paint.setColor(0xff127ee3);
+        canvas.drawRoundRect(new RectF(a, top, Math.min(b, a + dp(9)), bottom),
+                dp(5), dp(5), paint);
+        canvas.drawRoundRect(new RectF(Math.max(a, b - dp(9)), top, b, bottom),
+                dp(5), dp(5), paint);
+        paint.setColor(WHITE);
+        float handleH = Math.min(dp(28), track.height() - dp(8));
+        float y0 = track.centerY() - handleH / 2;
+        float y1 = track.centerY() + handleH / 2;
+        float handleInset = Math.min(dp(5), Math.max(dp(1), (b - a) / 4f));
+        float handleW = dp(2.2f);
+        canvas.drawRoundRect(a + handleInset - handleW / 2, y0,
+                a + handleInset + handleW / 2, y1, dp(1), dp(1), paint);
+        canvas.drawRoundRect(b - handleInset - handleW / 2, y0,
+                b - handleInset + handleW / 2, y1, dp(1), dp(1), paint);
+
+        // The chip stays inside the selected range even when handles move.
+        playPill.setEmpty();
+        float usable = b - a - dp(20);
+        if (usable >= dp(30)) {
+            float chipW = Math.min(dp(76), usable);
+            float chipH = dp(28);
+            float cx = (a + b) * .5f;
+            float cy = track.centerY();
+            playPill.set(cx - chipW / 2, cy - chipH / 2,
+                    cx + chipW / 2, cy + chipH / 2);
+            paint.setColor(0xff197cce);
+            canvas.drawRoundRect(playPill, dp(14), dp(14), paint);
+            drawAudioPlayIcon(canvas, cx - (chipW >= dp(58) ? dp(24) : 0), cy);
+            if (chipW >= dp(58)) {
+                paint.setStyle(Paint.Style.FILL);
+                paint.setColor(Color.WHITE);
+                paint.setTypeface(android.graphics.Typeface.create("sans-serif-medium", 0));
+                paint.setTextAlign(Paint.Align.CENTER);
+                paint.setTextSize(sp(12));
+                String time = TimeQuoteController.format(Math.max(0, playbackMs - startMs));
+                float textX = cx + dp(8);
+                canvas.drawText(time, textX, cy - (paint.ascent() + paint.descent()) / 2f, paint);
+                paint.setTypeface(null);
+                paint.setTextAlign(Paint.Align.LEFT);
+            }
+        }
+    }
+
+    private void drawAudioPlayIcon(Canvas canvas, float x, float y) {
+        paint.setColor(Color.WHITE);
+        paint.setStyle(Paint.Style.FILL);
+        if (playing) {
+            canvas.drawRoundRect(x - dp(5), y - dp(5), x - dp(2), y + dp(5),
+                    dp(1), dp(1), paint);
+            canvas.drawRoundRect(x + dp(2), y - dp(5), x + dp(5), y + dp(5),
+                    dp(1), dp(1), paint);
+        } else {
+            Path triangle = new Path();
+            triangle.moveTo(x - dp(4), y - dp(6));
+            triangle.lineTo(x + dp(6), y);
+            triangle.lineTo(x - dp(4), y + dp(6));
+            triangle.close();
+            canvas.drawPath(triangle, paint);
+        }
+    }
+
+    private void drawAudioBars(Canvas canvas, int color) {
+        if (waveform == null || waveform.length == 0) return;
+        float step = dp(3);
+        int bars = Math.max(1, (int) (width() / step));
+        paint.setColor(color);
+        for (int i = 0; i < bars; i++) {
+            float samplePosition = (i + .5f) * waveform.length / bars;
+            int sample = Math.min(waveform.length - 1, (int) samplePosition);
+            float amplitude = Math.max(0, Math.min(1, waveform[sample]));
+            float height = dp(3) + (float) Math.sqrt(amplitude) * dp(13);
+            float x = left() + (i + .5f) * width() / bars;
+            float halfWidth = dp(1);
+            float centerY = track.centerY();
+            canvas.drawRoundRect(x - halfWidth, centerY - height / 2,
+                    x + halfWidth, centerY + height / 2, halfWidth, halfWidth, paint);
+        }
+    }
+
+    private void drawThumbnails(Canvas canvas) {
+        if (frames == null) return;
+        float tile = width() / frames.length;
+        for (int i = 0; i < frames.length; i++) {
+            Bitmap bitmap = frames[i];
+            if (bitmap == null || bitmap.isRecycled()) continue;
+            float l = left() + tile * i;
+            RectF target = new RectF(l, track.top, l + tile + 1, track.bottom);
+            float desiredRatio = target.width() / target.height();
+            float actualRatio = bitmap.getWidth() / (float) bitmap.getHeight();
+            Rect src;
+            if (actualRatio > desiredRatio) {
+                int cropped = Math.max(1, (int) (bitmap.getHeight() * desiredRatio));
+                int x0 = (bitmap.getWidth() - cropped) / 2;
+                src = new Rect(x0, 0, x0 + cropped, bitmap.getHeight());
+            } else {
+                int cropped = Math.max(1, (int) (bitmap.getWidth() / desiredRatio));
+                int y0 = (bitmap.getHeight() - cropped) / 2;
+                src = new Rect(0, y0, bitmap.getWidth(), y0 + cropped);
+            }
+            paint.setColor(WHITE);
+            canvas.drawBitmap(bitmap, src, target, paint);
+        }
+        // Unselected frames are muted, selected frames stay visible through the blue overlay.
+        paint.setColor(0x640e243b);
+        canvas.drawRect(left(), track.top, at(startMs), track.bottom, paint);
+        canvas.drawRect(at(endMs), track.top, left() + width(), track.bottom, paint);
+    }
+
+    private void drawWaveform(Canvas canvas, int color) {
+        if (waveform == null || waveform.length == 0) return;
+        paint.setColor(color);
+        float gap = width() / waveform.length;
+        for (int i = 0; i < waveform.length; i++) {
+            float x = left() + gap * (i + .5f);
+            float h = Math.max(dp(2), (track.height() - dp(5)) * waveform[i]);
+            float centerY = track.centerY();
+            float half = Math.min(dp(1.5f), gap * .31f);
+            canvas.drawRoundRect(x - half, centerY - h / 2, x + half,
+                    centerY + h / 2, half, half, paint);
+        }
+    }
+
+    @Override public boolean onTouchEvent(MotionEvent event) {
+        float x = event.getX();
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                downX = x;
+                moved = false;
+                float l = at(startMs), r = at(endMs);
+                if (Math.abs(x - l) <= dp(14) && Math.abs(x - l) <= Math.abs(x - r)) {
+                    active = 0;
+                } else if (Math.abs(x - r) <= dp(14)) {
+                    active = 1;
+                } else if (playPill.contains(x, event.getY())) {
+                    active = 3;
+                } else if (x >= l && x <= r) {
+                    active = 2;
+                } else {
+                    active = Math.abs(x - l) < Math.abs(x - r) ? 0 : 1;
+                }
+                if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(true);
+                return true;
+            case MotionEvent.ACTION_MOVE:
+            case MotionEvent.ACTION_UP:
+                if (active < 0) return false;
+                if (Math.abs(x - downX) > touchSlop) moved = true;
+                long value = at(x);
+                long min = Math.min(300, durationMs);
+                if (active == 0) {
+                    startMs = clamp(value, 0, endMs - min);
+                    playbackMs = startMs;
+                    if (listener != null) listener.onChange(startMs, endMs);
+                } else if (active == 1) {
+                    endMs = clamp(value, startMs + min, durationMs);
+                    playbackMs = startMs;
+                    if (listener != null) listener.onChange(startMs, endMs);
+                } else if (active == 2) {
+                    playbackMs = clamp(value, startMs, endMs);
+                    if (listener != null) listener.onSeek(playbackMs);
+                } else if (active == 3) {
+                    if (moved) {
+                        // Dragging the inline play pill still seeks through the range.
+                        playbackMs = clamp(value, startMs, endMs);
+                        if (listener != null) listener.onSeek(playbackMs);
+                    } else if (event.getActionMasked() == MotionEvent.ACTION_UP) {
+                        if (listener != null) listener.onTogglePlay();
+                        performClick();
+                    }
+                }
+                invalidate();
+                if (event.getActionMasked() == MotionEvent.ACTION_UP) active = -1;
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                active = -1;
+                return true;
+            default:
+                return super.onTouchEvent(event);
+        }
+    }
+
+    @Override public boolean performClick() {
+        super.performClick();
+        return true;
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        generation++;
+        recycle(frames);
+        frames = null;
+        super.onDetachedFromWindow();
+    }
+}
