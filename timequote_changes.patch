+                !(message.isVoice() || message.isRoundVideo()) ||
+                message.isVoiceOnce() || message.isRoundOnce() || message.isSecretMedia() ||
+                message.messageOwner.noforwards || message.isEphemeral() ||
+                message.messageOwner.ttl_period > 0) {
+            Toast.makeText(activity, "Это сообщение нельзя цитировать", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        File local = findCompleteLocalFile(message);
+        if (local == null) {
+            downloadBeforeEditing(message);
+        } else {
+            openLocalEditor(message, local);
+        }
+    }
+
+    /** Check Telegram's ordinary media directory, its cache and message attachPath. */
+    private File findCompleteLocalFile(MessageObject message) {
+        FileLoader loader = FileLoader.getInstance(message.currentAccount);
+        if (message.messageOwner.attachPath != null &&
+                !message.messageOwner.attachPath.isEmpty()) {
+            File attached = new File(message.messageOwner.attachPath);
+            if (attached.isFile() && attached.length() > 0) return attached;
+        }
+        File candidate = loader.getPathToMessage(message.messageOwner);
+        if (candidate != null && candidate.isFile() && candidate.length() > 0) return candidate;
+        TLRPC.Document document = message.getDocument();
+        if (document != null) {
+            candidate = loader.getPathToAttach(document, false);
+            if (candidate != null && candidate.isFile() && candidate.length() > 0) return candidate;
+            candidate = loader.getPathToAttach(document, true);
+            if (candidate != null && candidate.isFile() && candidate.length() > 0) return candidate;
+        }
+        return null;
+    }
+
+    private void downloadBeforeEditing(MessageObject message) {
+        TLRPC.Document document = message.getDocument();
+        if (document == null) {
+            Toast.makeText(activity, "Медиафайл не найден в сообщении", Toast.LENGTH_LONG).show();
+            return;
+        }
+        String fileName = FileLoader.getAttachFileName(document);
+        if (fileName == null || fileName.isEmpty()) {
