+    private void showQuickAttachmentOverlay(View sourceView) {
+        if (quickAttachmentOverlay != null || !(getRootView() instanceof ViewGroup)) {
+            return;
+        }
+        ViewGroup root = (ViewGroup) getRootView();
+        int[] sourceLocation = new int[2];
+        int[] rootLocation = new int[2];
+        sourceView.getLocationOnScreen(sourceLocation);
+        root.getLocationOnScreen(rootLocation);
+        final ArrayList<MediaController.PhotoEntry> recentPhotos = new ArrayList<>();
+        if (MediaController.allPhotosAlbumEntry != null) {
+            for (MediaController.PhotoEntry photo : MediaController.allPhotosAlbumEntry.photos) {
+                if (photo != null && photo.path != null && !photo.isVideo) {
+                    recentPhotos.add(photo);
+                    if (recentPhotos.size() == 4) {
+                        break;
+                    }
+                }
+            }
+        }
+        if (recentPhotos.isEmpty()) {
+            // Consume the eventual ACTION_UP so the long-press fallback does
+            // not also trigger the normal click listener.
+            quickAttachmentTracking = true;
+            if (delegate != null) {
+                delegate.didPressAttachButton();
+            }
+            return;
+        }
+        quickAttachmentOverlay = new QuickAttachmentOverlayView(getContext(), photo -> {
+            quickPhotoTransitionPending = true;
+            if (delegate != null) {
+                delegate.didPressQuickPhoto(photo);
+            }
+        }, () -> {
+            quickAttachmentOverlay = null;
+            quickPhotoMessageObject = null;
+            quickPhotoTransitionPending = false;
+        });
+        root.addView(quickAttachmentOverlay, new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        final float sourceX = sourceLocation[0] - rootLocation[0] + sourceView.getWidth() / 2f;
+        final float sourceY = sourceLocation[1] - rootLocation[1] + sourceView.getHeight() / 2f;
+        // The root may not have performed its first layout yet (for example
+        // directly after opening a chat). Let the overlay calculate its fan
+        // after it has a real size, otherwise the strip can be placed at x=0.
+        quickAttachmentOverlay.post(() -> {
+            if (quickAttachmentOverlay != null) {
+                quickAttachmentOverlay.present(sourceX, sourceY, recentPhotos);
+            }
+        });
+    }
+
+    private void updateQuickAttachmentOverlay(MotionEvent event) {
+        if (quickAttachmentOverlay == null) {
+            return;
+        }
+        View root = getRootView();
+        int[] buttonLocation = new int[2];
+        int[] rootLocation = new int[2];
+        attachButton.getLocationOnScreen(buttonLocation);
+        root.getLocationOnScreen(rootLocation);
+        quickAttachmentOverlay.updateTracking(
+                buttonLocation[0] - rootLocation[0] + event.getX(),
+                buttonLocation[1] - rootLocation[1] + event.getY()
+        );
+    }
+
+    private void finishQuickAttachmentOverlay(MotionEvent event, boolean cancelled) {
+        quickAttachmentTracking = false;
+        if (quickAttachmentLongPress != null) {
+            removeCallbacks(quickAttachmentLongPress);
+            quickAttachmentLongPress = null;
+        }
+        if (quickAttachmentOverlay == null) {
+            return;
+        }
+        View root = getRootView();
+        int[] buttonLocation = new int[2];
+        int[] rootLocation = new int[2];
+        attachButton.getLocationOnScreen(buttonLocation);
+        root.getLocationOnScreen(rootLocation);
+        float x = buttonLocation[0] - rootLocation[0] + event.getX();
+        float y = buttonLocation[1] - rootLocation[1] + event.getY();
+        QuickAttachmentOverlayView overlay = quickAttachmentOverlay;
+        if (cancelled) {
+            overlay.cancelTracking();
+        } else {
+            overlay.finishTracking(x, y);
+        }
+    }
